@model QuizModel
<section id="quiz" data-lekcja="@Model.LekcjaId" data-trudnosci="@(Model.Trudnosci ? "1" : "0")" data-polecany="@Model.Polecany">
    <div id="quiz-start">
        @if (Model.Trudnosci)
        {
            <p>Wybierz poziom trudności:</p>
            <div class="wybor">
                <button type="button" class="trud @(Model.Polecany == 1 ? "aktywny" : "")" data-t="1">Łatwy</button>
                <button type="button" class="trud @(Model.Polecany == 2 ? "aktywny" : "")" data-t="2">Średni</button>
                <button type="button" class="trud @(Model.Polecany == 3 ? "aktywny" : "")" data-t="3">Trudny</button>
            </div>
            @if (!string.IsNullOrEmpty(Model.Powod))
            {
                var nazwy = new[] { "", "łatwy", "średni", "trudny" };
                <p class="meta polecany">Polecany poziom: <b>@nazwy[Math.Clamp(Model.Polecany, 1, 3)]</b>. @Model.Powod</p>
            }
            <p class="meta">Punkty za poprawną odpowiedź: łatwy 10, średni 20, trudny 30.</p>
        }
        <p class="meta" id="quiz-info"></p>
        <button type="button" class="przycisk" id="quiz-zacznij">Zacznij</button>
    </div>
    <div id="quiz-gra" hidden>
        <div class="pasek"><div id="quiz-pasek"></div></div>
        <p class="meta">Pytanie <span id="quiz-nr"></span> | Czas pytania: <span id="quiz-czas">0</span> s | Czas całkowity: <span id="quiz-calosc">0</span> s</p>
        <h3 id="quiz-tresc"></h3>
        <div id="quiz-odp"></div>
        <button type="button" class="przycisk" id="quiz-dalej" hidden>Dalej</button>
    </div>
    <div id="quiz-koniec" hidden>
        <p class="wynik" id="quiz-wynik"></p>
        <button type="button" class="przycisk" id="quiz-ponow">Spróbuj ponownie</button>
        <button type="button" class="przycisk jasny" id="quiz-zmien">Zmień poziom trudności</button>
    </div>
</section>
<script id="dane-quiz" type="application/json">@Json.Serialize(Model.Pytania.Select(p => new { id = p.Id, tresc = p.Tresc, odp = new[] { p.OdpA, p.OdpB, p.OdpC, p.OdpD }, poprawna = p.Poprawna, trudnosc = p.Trudnosc }))</script>
